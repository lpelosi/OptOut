# ── Core ────────────────────────────────────────────────────────
PORT=4000
APP_NAME=OptOut
# Public base URL of the API (used in emails). Production: https://api.optout.louispelosi.info
PUBLIC_URL=http://localhost:4000
# Comma-separated origins allowed for CORS (the app uses native fetch, but the
# Expo web build + local dev need these).
CORS_ORIGINS=http://localhost:8081,http://localhost:19006

# ── Postgres ────────────────────────────────────────────────────
# e.g. postgres://optout:password@localhost:5432/optout
DATABASE_URL=postgres://optout:optout@localhost:5432/optout

# ── JWT ─────────────────────────────────────────────────────────
# Generate each: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=
JWT_REFRESH_SECRET=

# ── Sign in with Apple ──────────────────────────────────────────
# Services ID configured in the Apple Developer portal (audience of the identity token).
APPLE_SERVICES_ID=

# ── Google sign-in ──────────────────────────────────────────────
# Comma-separated accepted client IDs (iOS, Android, web from Google Cloud console).
GOOGLE_CLIENT_IDS=

# ── Magic-link email codes ──────────────────────────────────────
MAGIC_CODE_TTL_MIN=10

# ── Receipt scanning (Claude vision) ────────────────────────────
# Anthropic API key. Leave empty to disable the /receipts/parse endpoint.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-4-8

# ── SMTP (reuse the existing server mail relay) ─────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM="OptOut <no-reply@louispelosi.info>"
