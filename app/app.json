{
  "expo": {
    "name": "OptOut",
    "slug": "optout",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "optout",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "splash": {
      "backgroundColor": "#0E1116",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "info.louispelosi.optout",
      "usesAppleSignIn": true
    },
    "android": {
      "package": "info.louispelosi.optout",
      "adaptiveIcon": {
        "backgroundColor": "#0E1116"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
