{
  "expo": {
    "name": "OptOut",
    "slug": "optout",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "optout",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "backgroundColor": "#0E1116",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "info.louispelosi.optout",
      "usesAppleSignIn": true,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "info.louispelosi.optout",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0E1116"
      }
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-apple-authentication",
      "expo-asset",
      "@react-native-community/datetimepicker",
      [
        "expo-camera",
        {
          "cameraPermission": "OptOut uses the camera to scan receipts and pull out the total automatically."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "65bca71f-7dfb-4b53-91c3-ee06c1200036"
      }
    }
  }
}
