# Base URL of the OptOut API. EXPO_PUBLIC_ vars are inlined into the app bundle.
# Local dev (device on same network): use your machine's LAN IP, not localhost.
EXPO_PUBLIC_API_URL=http://localhost:4000

# Google OAuth client IDs (from Google Cloud console). Leave all empty to hide the
# Google button. iOS uses the iOS id, Android the Android id, web the web id.
EXPO_PUBLIC_GOOGLE_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_ANDROID_CLIENT_ID=
